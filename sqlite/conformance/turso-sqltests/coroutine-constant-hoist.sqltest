@database :memory:
@requires-file custom_types "uses SMALLINT cast and array-typed columns"

test coroutine-for-table-function-derived-table-with-hoisted-cast {
    -- A CAST to a registered custom type (SMALLINT) that is itself a
    -- compile-time constant used to leave its "constant span" open when
    -- returning early, letting the next unrelated non-constant expression
    -- close it and sweep everything emitted in between - including this
    -- correlated derived table's own coroutine setup - into the hoisted
    -- "run once" tail, so it ran at most once instead of once per row.
    CREATE TABLE t (id INTEGER, opts ANY);
    INSERT INTO t VALUES (1, '{3,1,2}');
    INSERT INTO t VALUES (2, '{9,7,8}');
    SELECT id, (SELECT array_agg(x.v) FROM (SELECT value AS v FROM unnest(t.opts) ORDER BY value) AS x)
    FROM t WHERE id > CAST(0 AS SMALLINT) ORDER BY id;
}
expect {
    1|{1,2,3}
    2|{7,8,9}
}

test coroutine-for-plain-derived-table-with-hoisted-cast {
    -- Same shape, but the correlated derived table needing its own
    -- coroutine has no table function at all (ORDER BY + LIMIT forces a
    -- sorter-backed coroutine). Confirms the bug is not specific to table
    -- functions.
    CREATE TABLE t2 (id INTEGER, a INTEGER, b INTEGER);
    INSERT INTO t2 VALUES (1, 30, 300);
    INSERT INTO t2 VALUES (2, 10, 100);
    INSERT INTO t2 VALUES (3, 20, 200);
    SELECT id, (SELECT x.a FROM (SELECT t2.a AS a FROM t2 AS inner_t2 ORDER BY inner_t2.b DESC LIMIT 1) AS x)
    FROM t2 WHERE id > CAST(0 AS SMALLINT) ORDER BY id;
}
expect {
    1|30
    2|10
    3|20
}

test coroutine-for-plain-derived-table-with-hoisted-domain-cast {
    -- Domain casts share the same early-return shape as plain custom-type
    -- casts (both used to bypass the common span-close on their way out
    -- of the CAST arm).
    CREATE DOMAIN pos_smallint AS smallint CHECK (value > 0);
    CREATE TABLE t3 (id INTEGER, a INTEGER, b INTEGER);
    INSERT INTO t3 VALUES (1, 30, 300);
    INSERT INTO t3 VALUES (2, 10, 100);
    INSERT INTO t3 VALUES (3, 20, 200);
    SELECT id, (SELECT x.a FROM (SELECT t3.a AS a FROM t3 AS inner_t3 ORDER BY inner_t3.b DESC LIMIT 1) AS x)
    FROM t3 WHERE id > CAST(1 AS pos_smallint) ORDER BY id;
}
expect {
    2|10
    3|20
}
